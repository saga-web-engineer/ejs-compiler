{
  "name": "@s.a.g.a/ejs-compiler",
  "version": "1.0.0",
  "description": "Simple EJS compiler written in TypeScript, usable as both CLI and library",
  "type": "module",
  "bin": {
    "ejs-compiler": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ejs",
    "cli",
    "compiler",
    "ejs-compiler",
    "ejs-cli",
    "saga",
    "template"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "saga-web-engineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saga-web-engineer/ejs-compiler.git"
  },
  "homepage": "https://github.com/saga-web-engineer/ejs-compiler#readme",
  "bugs": {
    "url": "https://github.com/saga-web-engineer/ejs-compiler/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test:cli": "vitest run src/cli",
    "prepublishOnly": "npm run build",
    "format": "biome check --write .",
    "test": "vitest run",
    "lint": "biome check .",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "ejs": "^5.0.2",
    "fast-glob": "^3.3.3",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.12.2",
    "tsdown": "^0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
