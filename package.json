{
  "name": "ejs-compiler",
  "version": "1.0.0",
  "description": "Modern EJS template compiler with TypeScript support",
  "type": "module",
  "bin": {
    "ejs-compiler": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ejs",
    "cli",
    "compiler",
    "ejs-compiler",
    "template"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "unbuild --stub",
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "test:cli": "node dist/cli.mjs -b test/templates/pages/ -f \"**/[!_]*.ejs\" -o test/dist/ -O test/data.json -e \"about.ejs\"",
    "format": "biome check --write .",
    "lint": "biome check ."
  },
  "volta": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "dependencies": {
    "citty": "^0.2.1",
    "consola": "^3.4.2",
    "ejs": "^4.0.1",
    "fast-glob": "^3.3.3",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.10.13",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1"
  }
}
