{
  "name": "@s.a.g.a/ejs-compiler",
  "version": "0.1.0",
  "description": "Simple EJS compiler written in TypeScript, usable as both CLI and library",
  "type": "module",
  "bin": {
    "ejs-compiler": "./dist/cli.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ejs",
    "cli",
    "compiler",
    "ejs-compiler",
    "ejs-cli",
    "saga",
    "template"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "saga-web-engineer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saga-web-engineer/ejs-compiler.git"
  },
  "homepage": "https://github.com/saga-web-engineer/ejs-compiler#readme",
  "bugs": {
    "url": "https://github.com/saga-web-engineer/ejs-compiler/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "unbuild --stub",
    "build": "unbuild",
    "prepublishOnly": "npm run build",
    "example:cli": "node dist/cli.mjs -b examples/templates/pages/ -f \"**/[!_]*.ejs\" -o examples/dist/ -O examples/data.json -e \"about.ejs\"",
    "example:file": "node examples/compile-to-file.js",
    "example:memory": "node examples/compile-to-memory.js",
    "format": "biome check --write .",
    "test": "vitest run src"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "ejs": "^5.0.2",
    "fast-glob": "^3.3.3",
    "pathe": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.12.2",
    "typescript": "^6.0.3",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  }
}
